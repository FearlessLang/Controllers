<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

  <extension id="problem" point="org.eclipse.core.resources.markers" name="Fearless Problem">
    <super type="org.eclipse.core.resources.problemmarker"/>
    <persistent value="true"/>
  </extension>

  <extension id="nature" point="org.eclipse.core.resources.natures" name="Fearless Nature">
    <runtime><run class="fearlessPluginProject.Nature"/></runtime>
    <builder id="fearlessPluginProject.builder"/>
  </extension>

  <extension id="builder" point="org.eclipse.core.resources.builders" name="Fearless Builder">
    <builder hasNature="true"><run class="fearlessPluginProject.Builder"/></builder>
  </extension>

  <extension point="org.eclipse.ui.startup">
    <startup class="fearlessPluginProject.FearlessWatcher"/>
  </extension>

  <extension point="org.eclipse.ui.perspectives">
    <perspective id="fearlessPluginProject.perspective" name="Fearless"
      class="fearlessPluginProject.FearlessPerspective" icon="icons/fearless16.png"/>
  </extension>

  <extension point="org.eclipse.ui.perspectiveExtensions">
    <perspectiveExtension targetID="fearlessPluginProject.perspective">
      <hiddenMenuItem id="org.eclipse.ui.run"/>
      <hiddenToolBarItem id="newWizardDropDown"/>
      <hiddenToolBarItem id="org.eclipse.ui.file.saveAll"/>
      <hiddenToolBarItem id="org.eclipse.ui.window.pinEditor"/>
      <hiddenToolBarItem id="org.eclipse.debug.internal.ui.actions.RunDropDownAction"/>
      <hiddenToolBarItem id="org.eclipse.debug.internal.ui.actions.DebugDropDownAction"/>
      <hiddenToolBarItem id="org.eclipse.debug.internal.ui.actions.ProfileDropDownAction"/>
      <hiddenToolBarItem id="org.eclipse.eclemma.ui.actions.CoverageDropDownAction"/>
      <hiddenToolBarItem id="org.eclipse.ui.externaltools.ExternalToolMenuDelegateToolbar"/>
      <hiddenToolBarItem id="org.eclipse.mylyn.tasks.ui.command.openTask"/>
      <hiddenToolBarItem id="org.eclipse.terminal.view.ui.toolbar"/>
      <hiddenToolBarItem id="org.eclipse.terminal.view.ui.commands.launchToolbar"/>
    </perspectiveExtension>
  </extension>

  <extension point="org.eclipse.ui.views">
    <view id="fearlessPluginProject.explorer" name="Fearless Explorer" icon="icons/fearless16.png"
      class="org.eclipse.ui.navigator.CommonNavigator"/>
    <view id="fearlessPluginProject.output" name="Output" icon="icons/fearless16.png"
      class="fearlessPluginProject.Output"/>
  </extension>

  <extension point="org.eclipse.ui.navigator.viewer">
    <viewer viewerId="fearlessPluginProject.explorer"/>
    <viewerContentBinding viewerId="fearlessPluginProject.explorer">
      <includes>
        <contentExtension pattern="org.eclipse.ui.navigator.resourceContent"/>
        <contentExtension pattern="org.eclipse.ui.navigator.resources.filters.*"/>
        <contentExtension pattern="org.eclipse.ui.navigator.resources.linkHelper"/>
        <contentExtension pattern="fearlessPluginProject.only"/>
      </includes>
    </viewerContentBinding>
    <viewerActionBinding viewerId="fearlessPluginProject.explorer">
      <includes><actionExtension pattern="org.eclipse.ui.navigator.resources.*"/></includes>
    </viewerActionBinding>
    <viewerContentBinding viewerId="org.eclipse.ui.navigator.ProjectExplorer">
      <includes><contentExtension pattern="fearlessPluginProject.hide"/></includes>
    </viewerContentBinding>
  </extension>

  <extension point="org.eclipse.ui.navigator.navigatorContent">
    <commonFilter id="fearlessPluginProject.only" name="Everything but Fearless projects"
      activeByDefault="true" class="fearlessPluginProject.Filters$Only"/>
    <commonFilter id="fearlessPluginProject.hide" name="Fearless projects"
      activeByDefault="true" class="fearlessPluginProject.Filters$Hide"/>
  </extension>

  <extension point="org.eclipse.jdt.ui.javaElementFilters">
    <filter id="fearlessPluginProject.hideJava" name="Fearless projects" enabled="true"
      class="fearlessPluginProject.Filters$Hide" targetId="org.eclipse.jdt.ui.PackageExplorer"/>
  </extension>

  <extension point="org.eclipse.ui.newWizards">
    <category id="fearlessPluginProject.wizards" name="Fearless"/>
    <wizard id="fearlessPluginProject.newProject" name="Fearless Project" category="fearlessPluginProject.wizards"
      class="fearlessPluginProject.NewProjectWizard" icon="icons/fearless16.png" project="true"/>
    <wizard id="fearlessPluginProject.newFolder" name="Folder" category="fearlessPluginProject.wizards"
      class="fearlessPluginProject.NewFolder" icon="platform:/plugin/org.eclipse.ui.ide/icons/full/obj16/folder.png"/>
    <wizard id="fearlessPluginProject.newFile" name="File" category="fearlessPluginProject.wizards"
      class="fearlessPluginProject.NewFile" icon="platform:/plugin/org.eclipse.ui.ide/icons/full/etool16/newfile_wiz.png"/>
  </extension>

  <extension point="org.eclipse.core.contenttype.contentTypes">
    <content-type id="fearlessPluginProject.source" name="Fearless Source"
      base-type="org.eclipse.core.runtime.text" file-extensions="fear,fearless" priority="high"/>
  </extension>

  <extension point="org.eclipse.ui.editors">
    <editorContentTypeBinding contentTypeId="fearlessPluginProject.source"
      editorId="org.eclipse.ui.genericeditor.GenericEditor"/>
  </extension>

  <extension point="org.eclipse.ui.genericeditor.contentAssistProcessors">
    <contentAssistProcessor class="fearlessPluginProject.Assist" contentType="fearlessPluginProject.source"/>
  </extension>

  <extension point="org.eclipse.tm4e.registry.grammars">
    <grammar scopeName="source.fearless" path="syntaxes/fearless.tmLanguage.json"/>
    <scopeNameContentTypeBinding scopeName="source.fearless" contentTypeId="fearlessPluginProject.source"/>
  </extension>

  <extension point="org.eclipse.tm4e.ui.themes">
    <theme id="fearlessPluginProject.light" name="Fearless Light" path="themes/fearless-light.css"/>
    <theme id="fearlessPluginProject.dark" name="Fearless Dark" path="themes/fearless-dark.css" dark="true"/>
    <themeAssociation themeId="fearlessPluginProject.light" scopeName="source.fearless" whenDark="false"/>
    <themeAssociation themeId="fearlessPluginProject.dark" scopeName="source.fearless" whenDark="true"/>
  </extension>

  <extension point="org.eclipse.ui.handlers">
    <handler commandId="org.eclipse.ui.file.save" class="fearlessPluginProject.Save">
      <activeWhen>
        <with variable="activeEditorInput">
          <adapt type="org.eclipse.core.resources.IResource">
            <test property="org.eclipse.core.resources.projectNature" value="fearlessPluginProject.nature"/>
          </adapt>
        </with>
      </activeWhen>
    </handler>
  </extension>

  <extension point="org.eclipse.ui.commands">
    <command id="fearlessPluginProject.main" name="Fearless Main Button" defaultHandler="fearlessPluginProject.MainButton"/>
    <command id="fearlessPluginProject.newSource" name="New Fearless Package or Type">
      <commandParameter id="fearlessPluginProject.what" name="What" optional="false"/>
    </command>
  </extension>

  <extension point="org.eclipse.ui.handlers">
    <handler commandId="fearlessPluginProject.newSource" class="fearlessPluginProject.NewSource">
      <enabledWhen>
        <or>
          <with variable="selection">
            <count value="1"/>
            <iterate>
              <adapt type="org.eclipse.core.resources.IResource">
                <test property="org.eclipse.core.resources.projectNature" value="fearlessPluginProject.nature"/>
              </adapt>
            </iterate>
          </with>
          <with variable="activeEditorInput">
            <adapt type="org.eclipse.core.resources.IResource">
              <test property="org.eclipse.core.resources.projectNature" value="fearlessPluginProject.nature"/>
            </adapt>
          </with>
        </or>
      </enabledWhen>
    </handler>
  </extension>

  <extension point="org.eclipse.ui.menus">
    <menuContribution locationURI="toolbar:org.eclipse.ui.main.toolbar?after=additions">
      <toolbar id="fearlessPluginProject.toolbar">
        <command commandId="fearlessPluginProject.newSource" tooltip="New Package"
          icon="platform:/plugin/org.eclipse.jdt.ui/icons/full/etool16/newpack_wiz.png">
          <parameter name="fearlessPluginProject.what" value="package"/>
          <visibleWhen checkEnabled="false">
            <with variable="activeWorkbenchWindow.activePerspective"><equals value="fearlessPluginProject.perspective"/></with>
          </visibleWhen>
        </command>
        <command commandId="fearlessPluginProject.newSource" tooltip="New Type"
          icon="platform:/plugin/org.eclipse.jdt.ui/icons/full/etool16/newclass_wiz.png">
          <parameter name="fearlessPluginProject.what" value="type"/>
          <visibleWhen checkEnabled="false">
            <with variable="activeWorkbenchWindow.activePerspective"><equals value="fearlessPluginProject.perspective"/></with>
          </visibleWhen>
        </command>
        <command commandId="fearlessPluginProject.main" tooltip="Run"
          icon="platform:/plugin/org.eclipse.debug.ui/icons/full/obj16/lrun_obj.png">
          <visibleWhen checkEnabled="false">
            <with variable="activeWorkbenchWindow.activePerspective"><equals value="fearlessPluginProject.perspective"/></with>
          </visibleWhen>
        </command>
      </toolbar>
    </menuContribution>
    <menuContribution locationURI="popup:org.eclipse.ui.popup.any?after=additions">
      <menu id="fearlessPluginProject.menu" label="Fearless" icon="icons/fearless16.png">
        <visibleWhen checkEnabled="false">
          <with variable="selection">
            <count value="1"/>
            <iterate>
              <adapt type="org.eclipse.core.resources.IResource">
                <test property="org.eclipse.core.resources.projectNature" value="fearlessPluginProject.nature"/>
              </adapt>
            </iterate>
          </with>
        </visibleWhen>
        <dynamic class="fearlessPluginProject.PopupItems" id="fearlessPluginProject.popup"/>
      </menu>
    </menuContribution>
  </extension>

</plugin>
